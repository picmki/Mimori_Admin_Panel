# ==============================================================================
# MIMORI DIGITAL - SUPABASE CONFIGURATION
# ==============================================================================
# 1. Sign in to your Supabase project: https://supabase.com/dashboard
# 2. Go to Project Settings -> API
# 3. Copy your "Project URL" and "anon public" or "service_role" API key below:

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
# Optional: Service role key for admin actions (bypass RLS)
SUPABASE_SERVICE_ROLE_KEY=
PORT=3000
